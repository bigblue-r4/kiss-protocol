[Unit]
Description=SGAIL Labs Harborlight Witness — machine-state continuous monitor
Documentation=https://github.com/bigblue-r4/kiss-protocol
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=witness
Group=witness
ExecStart=/usr/local/bin/witness start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# ── State directories (managed by systemd, mode 0700) ─────────────────────────
StateDirectory=witness
StateDirectoryMode=0700
RuntimeDirectory=witness
RuntimeDirectoryMode=0700

# ── Privilege reduction ───────────────────────────────────────────────────────
NoNewPrivileges=true
# One capability: read any file, write none. The witness fingerprints files
# only root can read (/etc/shadow, /etc/sudoers); without this they would read
# as removed on every drift check. It is granted as an ambient capability
# (the only way systemd can give one to a non-root user) and the witness clears
# the ambient set at start, so nothing it launches (Pipelock, ps, its watchdog)
# inherits it. Writes stay confined to ReadWritePaths below.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
SecureBits=noroot noroot-locked

# ── Filesystem isolation ──────────────────────────────────────────────────────
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/witness /run/witness
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true

# ── Process isolation ─────────────────────────────────────────────────────────
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true

# ── Memory protection ─────────────────────────────────────────────────────────
MemoryDenyWriteExecute=true

# ── Syscall filtering ─────────────────────────────────────────────────────────
# @system-service is the standard allowlist for well-behaved non-privileged
# daemons. The negative filter removes privileged subcategories witness never
# needs: raw sockets, kernel keyring, realtime scheduling, and deprecated calls.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallErrorNumber=EPERM

# The Go runtime requires these in addition to @system-service:
SystemCallFilter=clone3 rseq

# ── Environment ───────────────────────────────────────────────────────────────
Environment=HOME=/var/lib/witness
EnvironmentFile=-/etc/witness/witness.env

[Install]
WantedBy=multi-user.target
